# Specify cell type and genes of interest
heatmap_plot <- function(x, anno, a="row", cellType, genes){
anno_edit <- anno[colnames(x), c("Cell_state", "Treatment", "ID")]
cell_states <- c(anno_edit[which(anno_edit$Cell_state == cellType), c('ID')])
# Format dataframe
df <- x[,cell_states]
match_genes <- genes[which(genes %in% rownames(x))]
y <- df[match_genes,order(colnames(df))]
tpm_mat <- as.matrix(y)
rownames(tpm_mat) <- rownames(y)
tpm_mat_selected <- tpm_mat
anno_edit <- anno[colnames(tpm_mat_selected), c("Cell_state", "Treatment")]
p <- pheatmap(tpm_mat_selected, scale=a, cluster_rows = T, cluster_cols = F, annotation_col = anno_edit)
return(p)
}
