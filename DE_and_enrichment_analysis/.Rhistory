new_anno <- new_anno[colnames(df),]
MyGeneSet <- "../../Analysis_R/Mouse_cell_type_signature_GS.symbols.gmt.txt"
# Load GeneSets
GS <- GSA.read.gmt(MyGeneSet)
GS <- setNames(GS$genesets, GS$geneset.names)
GS <- lapply(GS, function(x) x[x!= ""])
x <- ssGSEA(df, GS)
ssgsea_heatmap(x, new_anno, rownames = TRUE)
