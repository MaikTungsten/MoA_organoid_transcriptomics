colnames(df_melt) <- c('Sample', 'Treatment', 'Gene', 'TPM_normalized_expression')
# Plot data
if (scale == 'linear'){
p <- ggplot(df_melt, aes(x = Treatment, y = TPM_normalized_expression, fill = Treatment, colour = Treatment)) +
geom_dotplot(binaxis='y', stackdir='center', stackratio=1.5, dotsize = 0.6) +
facet_grid(~ Gene, switch = "x") +
theme_minimal()+
theme(panel.spacing.x = grid::unit(0, "mm"),
strip.placement = "outside",
strip.background = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1))+
stat_summary(fun.y=mean, geom="point", shape=10,
size=3, color="grey")
} else if (scale == 'log'){
p <- ggplot(df_melt, aes(x = Treatment, y = TPM_normalized_expression, fill = Treatment, colour = Treatment)) +
geom_dotplot(binaxis='y', stackdir='center', stackratio=1.5, dotsize = 0.6) +
facet_grid(~ Gene, switch = "x") +
theme_minimal()+
theme(panel.spacing.x = grid::unit(0, "mm"),
strip.placement = "outside",
strip.background = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1))+
stat_summary(fun.y=mean, geom="point", shape=10,
size=3, color="grey")+
scale_y_continuous(trans = 'log10')
}
return(p)
}
